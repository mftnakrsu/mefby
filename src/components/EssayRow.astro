---
// One essay in a list (home page, /essays): title in the display face, a mono
// meta line (date · reading time · languages), the description and topics.
// "featured" adds a small "New" marker with a terracotta dot.
import type { CollectionEntry } from 'astro:content';
import { fmtDate, readingTime, essayLangs, topicTags } from '../lib/essayMeta';

interface Props {
  essay: CollectionEntry<'essays'>;
  featured?: boolean;
  // Keep 'as' quoted: unquoted, Astro ignores this Props type and callers go unchecked.
  'as'?: 'h2' | 'h3' | 'h4';
}
const { essay, featured = false, as: Heading = 'h3' } = Astro.props;
const langs = essayLangs(essay.data.lang, !!essay.data.translationSlug);
const tags = topicTags(essay.data.tags);
// Mark a Turkish essay's title and description, since the list is in English.
const lang = essay.data.lang === 'en' ? undefined : essay.data.lang;
---

<li class="border-b border-fg-line">
  <a href={`/essays/${essay.id}`} class="group block py-5">
    <div class="flex items-baseline gap-3">
      {essay.data.seriesOrder != null && (
        <span class="t-mono shrink-0 text-fg-muted">Part {essay.data.seriesOrder}</span>
      )}
      <Heading lang={lang} class="font-display text-[1.2rem] font-medium leading-snug tracking-[-0.01em] decoration-fg-line underline-offset-4 group-hover:underline">
        {essay.data.title}
      </Heading>
      {featured && (
        <span class="t-label inline-flex shrink-0 items-center gap-1.5 text-fg-muted">
          <span aria-hidden="true" class="size-1.5 rounded-full bg-accent"></span>New<span class="sr-only"> (most recent essay)</span>
        </span>
      )}
      <span aria-hidden="true" class="ml-auto shrink-0 text-fg-muted transition-transform motion-reduce:transition-none group-hover:translate-x-0.5">→</span>
    </div>
    <p class="t-mono mt-2 flex flex-wrap gap-x-2 text-fg-muted">
      <time datetime={essay.data.date.toISOString().slice(0, 10)}>{fmtDate(essay.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(essay.body)} min read</span>
      <span aria-hidden="true">·</span>
      <span><span class="sr-only">Available in </span>{langs.join(' · ')}</span>
    </p>
    {essay.data.description && (
      <p lang={lang} class="measure mt-2 line-clamp-2 text-[0.95rem] leading-relaxed text-fg-muted">{essay.data.description}</p>
    )}
    {tags.length > 0 && (
      <ul class="t-mono mt-2.5 flex flex-wrap gap-x-2 text-fg-muted" aria-label="Topics">
        {tags.map((tag) => <li>#{tag}</li>)}
      </ul>
    )}
  </a>
</li>
