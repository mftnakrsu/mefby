---
// Email, LinkedIn, GitHub and Medium. "labelled" shows text (hero, footer);
// "icon" shows 44px icon buttons with screen-reader labels (header).
import { PROFILE } from '../../../constants';

type Key = 'email' | 'linkedin' | 'github' | 'medium';
interface Props {
  variant?: 'labelled' | 'icon';
  include?: Key[];
  class?: string;
}
const { variant = 'labelled', include = ['email', 'linkedin', 'github'], class: className } = Astro.props;
const labelled = variant === 'labelled';

const LINKS: Record<Key, { href: string; label: string; srLabel: string; external: boolean }> = {
  email: { href: `mailto:${PROFILE.email}`, label: PROFILE.email, srLabel: `Email ${PROFILE.owner}`, external: false },
  linkedin: { href: PROFILE.socials.linkedin, label: 'LinkedIn', srLabel: `${PROFILE.owner} on LinkedIn`, external: true },
  github: { href: PROFILE.socials.github, label: 'GitHub', srLabel: `${PROFILE.owner} on GitHub`, external: true },
  medium: { href: PROFILE.socials.medium, label: 'Medium', srLabel: `${PROFILE.owner} on Medium`, external: true },
};
const items = include.map((key) => ({ key, ...LINKS[key] }));
---

<ul class:list={['flex flex-wrap items-center', labelled ? 'gap-x-6 gap-y-1' : 'gap-0', className]}>
  {items.map((item) => (
    <li>
      <a
        href={item.href}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener noreferrer' : undefined}
        class:list={[
          'group inline-flex items-center',
          labelled ? 'min-h-11 gap-2 text-[0.95rem]' : 'size-11 justify-center rounded-full transition-colors hover:bg-fg/5',
        ]}
      >
        {item.key === 'email' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 7 8.5 6 8.5-6" /></svg>
        )}
        {item.key === 'linkedin' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.64h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.49 4.78 5.73V21H17.6v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9V9Z" /></svg>
        )}
        {item.key === 'github' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
        )}
        {item.key === 'medium' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z" /></svg>
        )}
        {labelled ? (
          <span class="border-b border-transparent group-hover:border-current">{item.label}</span>
        ) : (
          <span class="sr-only">{item.srLabel}</span>
        )}
        {item.external && <span class="sr-only"> (opens in a new tab)</span>}
      </a>
    </li>
  ))}
</ul>
