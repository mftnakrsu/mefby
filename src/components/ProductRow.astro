---
import type { Product } from '../../types';
import { fmtMonth } from '../lib/productMeta';

interface Props {
  product: Product;
  // The /products index shows a screenshot under each row; the home page keeps it compact.
  showImage?: boolean;
}
const { product, showImage = false } = Astro.props;
const meta = [
  product.license ? `Open source (${product.license})` : null,
  product.languages?.length ? product.languages.join(' · ') : null,
].filter((m): m is string => m != null);
---

<li class="border-b border-zinc-100">
  <a
    href={`/products/${product.slug}`}
    class="group block py-5 -mx-2 px-2 rounded-lg transition-colors hover:bg-emerald-50/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/40"
  >
    <div class="flex items-baseline gap-2">
      <h3 class="text-[15px] font-medium text-zinc-900 leading-snug group-hover:text-emerald-700 transition-colors">
        {product.name}
      </h3>
      <span class="shrink-0 inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-1.5 py-px text-[10px] font-medium uppercase tracking-wider text-emerald-700">
        {product.status}
      </span>
      <span aria-hidden="true" class="ml-auto pl-2 text-zinc-300 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-all">&rarr;</span>
    </div>

    <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] font-mono text-zinc-600">
      <span>Launched <time datetime={product.launched}>{fmtMonth(product.launched)}</time></span>
      {meta.map((m) => (
        <Fragment>
          <span aria-hidden="true" class="text-zinc-300">&middot;</span>
          <span>{m}</span>
        </Fragment>
      ))}
    </div>

    <p class="mt-2 text-[13px] leading-relaxed text-zinc-500">{product.tagline}</p>

    {product.stack.length > 0 && (
      <ul class="mt-2.5 flex flex-wrap gap-x-2 gap-y-1" aria-label="Built with">
        {product.stack.map((tech) => (
          <li class="text-[10px] font-mono text-zinc-500 group-hover:text-emerald-600/80 transition-colors">{tech}</li>
        ))}
      </ul>
    )}

    {showImage && (
      <img
        src={product.image.src}
        alt={product.image.alt}
        width={product.image.width}
        height={product.image.height}
        decoding="async"
        class="mt-4 block w-full h-auto rounded-lg border border-zinc-200"
      />
    )}
  </a>
</li>
