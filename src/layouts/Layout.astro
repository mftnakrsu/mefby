---
import '../styles/global.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ProgressRail from '../components/site/ProgressRail.astro';

interface Alternate {
  hreflang: string;
  href: string;
}
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  ogType?: string;
  publishedTime?: string;
  tags?: string[];
  alternates?: Alternate[];
  variant?: 'home' | 'page';
}

const {
  title = 'Meftun Akarsu',
  description = 'AI Engineer — LLM infrastructure, computer vision, data pipelines.',
  ogImage = '/profile.jpg',
  lang = 'en',
  ogType = 'website',
  publishedTime,
  tags = [],
  alternates = [],
  variant = 'page',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const locale = lang === 'tr' ? 'tr_TR' : 'en_US';
// The home page gets the dock, the progress rail and the full footer.
const home = variant === 'home';
---

<!DOCTYPE html>
<html lang={lang} data-page={home ? 'home' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Meftun Akarsu" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && (
      <Fragment>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:alt" content={title} />
      </Fragment>
    )}
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && tags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Meftun Akarsu",
      jobTitle: "AI Engineer",
      url: Astro.site?.toString(),
      sameAs: [
        "https://www.linkedin.com/in/meftunakarsu/",
        "https://github.com/mftnakrsu",
      ],
    })} />
  </head>
  <body>
    <a
      href="#main"
      lang="en"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-paper focus:px-4 focus:py-2 focus:text-ink"
    >Skip to content</a>
    <SiteHeader mode={home ? 'dock' : 'static'} />
    {home && <ProgressRail />}
    <main id="main">
      <slot />
    </main>
    <SiteFooter variant={home ? 'full' : 'compact'} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
