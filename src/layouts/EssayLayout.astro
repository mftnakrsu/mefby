---
import Layout from './Layout.astro';
import { COURSES } from '../lib/courses';
// Only essays typeset math ($$…$$, rendered by KaTeX at build time), so only they load its CSS.
import 'katex/dist/katex.min.css';

interface SeriesLink {
  slug: string;
  title: string;
  seriesOrder?: number;
}
interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  lang?: string;
  slug?: string;
  summary?: string;
  translationSlug?: string;
  codeUrl?: string;
  ogImage?: string;
  series?: 'rag' | 'agents' | 'evals';
  seriesOrder?: number;
  seriesTotal?: number | null;
  prevEssay?: SeriesLink | null;
  nextEssay?: SeriesLink | null;
  readingMinutes?: number;
}
const {
  title, description, date, tags = [], lang = 'en', slug, summary, translationSlug, codeUrl, ogImage,
  series = 'rag', seriesOrder, seriesTotal, prevEssay, nextEssay, readingMinutes,
} = Astro.props;
const dateFormatted = date.toISOString().slice(0, 10);
const tr = lang === 'tr';
const langs = ['en', 'tr'] as const;

// English series names come from COURSES; these are the Turkish ones.
const SERIES_TR = {
  rag: 'RAG: İLK İLKELERDEN',
  agents: 'AJANLAR: İLK İLKELERDEN',
  evals: 'DEĞERLENDİRME: İLK İLKELERDEN',
} as const;
const course = COURSES.find((c) => c.series === series) ?? COURSES[0];
const inSeries = seriesOrder != null && seriesTotal != null;
const seriesLabel = tr
  ? `${SERIES_TR[series]} · BÖLÜM ${seriesOrder} / ${seriesTotal}`
  : `${course.title} · Part ${seriesOrder} of ${seriesTotal}`;

const abs = (path: string) => new URL(path, Astro.site).toString();
const canonicalUrl = slug ? abs(`/essays/${slug}/`) : abs(Astro.url.pathname);
const metaDescription = summary ?? description;
const ogImageUrl = ogImage ? abs(ogImage) : undefined;

// hreflang alternates for a translated pair: self, counterpart, and x-default → EN.
const counterpartLang = lang === 'en' ? 'tr' : 'en';
const alternates = (translationSlug && slug)
  ? [
      { hreflang: lang, href: abs(`/essays/${slug}/`) },
      { hreflang: counterpartLang, href: abs(`/essays/${translationSlug}/`) },
      { hreflang: 'x-default', href: abs(`/essays/${lang === 'en' ? slug : translationSlug}/`) },
    ]
  : [];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: metaDescription,
  datePublished: dateFormatted,
  dateModified: dateFormatted,
  inLanguage: lang,
  mainEntityOfPage: canonicalUrl,
  keywords: tags.join(", "),
  ...(ogImageUrl ? { image: ogImageUrl } : {}),
  author: {
    "@type": "Person",
    name: "Meftun Akarsu",
    url: "https://mefby.vercel.app",
    sameAs: [
      "https://www.linkedin.com/in/meftunakarsu/",
      "https://github.com/mftnakrsu",
    ],
  },
  publisher: {
    "@type": "Organization",
    name: "Meftun Akarsu",
    logo: { "@type": "ImageObject", url: abs("/icon.png") },
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: abs("/") },
    { "@type": "ListItem", position: 2, name: "Essays", item: abs("/essays/") },
    { "@type": "ListItem", position: 3, name: title, item: canonicalUrl },
  ],
};

const link = 'decoration-fg-line underline-offset-4 hover:underline';
---

<Layout
  title={title}
  description={metaDescription}
  lang={lang}
  ogImage={ogImage}
  ogType="article"
  publishedTime={dateFormatted}
  tags={tags}
  alternates={alternates}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <div class="mx-auto max-w-[46rem] px-6 pt-14 sm:pt-20">
    <article lang={lang}>
      <header class="mb-12">
        {inSeries && (
          <a href={course.href} class={`t-label mb-5 inline-block text-balance text-fg-muted ${link}`}>{seriesLabel}</a>
        )}
        <h1 class="text-balance font-display text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-[-0.015em]">{title}</h1>
        <p class="t-lead measure mt-6 text-fg-muted">{description}</p>
        <div class="t-mono mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-fg-muted">
          <time datetime={dateFormatted}>{dateFormatted}</time>
          {readingMinutes != null && (
            <Fragment>
              <span aria-hidden="true">·</span>
              <span>{readingMinutes} {tr ? 'dk okuma' : 'min read'}</span>
            </Fragment>
          )}
          {translationSlug && (
            <Fragment>
              <span aria-hidden="true">·</span>
              <nav aria-label={tr ? 'Dil' : 'Language'} class="flex items-center gap-1">
                {langs.map((code) => (
                  lang === code ? (
                    <span aria-current="true" class="rounded-full border border-fg-line px-2 py-0.5 text-fg">{code.toUpperCase()}</span>
                  ) : (
                    <a href={`/essays/${translationSlug}`} hreflang={code} class="rounded-full px-2 py-0.5 hover:text-fg">
                      {code.toUpperCase()}<span class="sr-only">{code === 'tr' ? ' (Türkçe oku)' : ' (Read in English)'}</span>
                    </a>
                  )
                ))}
              </nav>
            </Fragment>
          )}
          {codeUrl && (
            <Fragment>
              <span aria-hidden="true">·</span>
              <a href={codeUrl} target="_blank" rel="noopener noreferrer" class={link}>
                Code<span class="sr-only">{tr ? ' (yeni sekmede açılır)' : ' (opens in a new tab)'}</span> <span aria-hidden="true">↗</span>
              </a>
            </Fragment>
          )}
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      {tags.length > 0 && (
        <ul class="mt-14 flex flex-wrap gap-2 border-t border-fg-line pt-6" aria-label={tr ? 'Etiketler' : 'Tags'}>
          {tags.map((tag) => (
            <li class="t-mono rounded-full border border-fg-line px-2.5 py-1 text-fg-muted">{tag}</li>
          ))}
        </ul>
      )}
    </article>

    {inSeries && (prevEssay || nextEssay) && (
      <nav aria-label="Series navigation" class="mt-14 grid grid-cols-2 gap-4">
        {prevEssay ? (
          <a href={`/essays/${prevEssay.slug}`} class="group block rounded-xl border border-fg-line p-4 transition-colors hover:border-fg">
            <span class="t-mono block text-fg-muted">← Part {prevEssay.seriesOrder}</span>
            <span class="mt-1 block font-display text-[1.05rem] font-medium leading-snug">{prevEssay.title}</span>
          </a>
        ) : <span></span>}
        {nextEssay ? (
          <a href={`/essays/${nextEssay.slug}`} class="group block rounded-xl border border-fg-line p-4 text-right transition-colors hover:border-fg">
            <span class="t-mono block text-fg-muted">Part {nextEssay.seriesOrder} →</span>
            <span class="mt-1 block font-display text-[1.05rem] font-medium leading-snug">{nextEssay.title}</span>
          </a>
        ) : <span></span>}
      </nav>
    )}
  </div>
</Layout>

<script>
  // Add a copy-to-clipboard button to every fenced code block.
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (!code) return;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code to clipboard');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.innerText);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Failed';
      }
      setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
    });
    pre.appendChild(btn);
  });
</script>
