---
import Layout from '../../layouts/Layout.astro';
import SectionMeta from '../../components/site/SectionMeta.astro';
import Label from '../../components/site/Label.astro';
import Button from '../../components/site/Button.astro';
import { PRODUCTS } from '../../../constants';
import type { Product } from '../../../types';
import { fmtMonth, operatingSystem, productFacts, productLinks } from '../../lib/productMeta';
import { twoDigits } from '../../lib/sections';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const { image, video, steps = [], gallery = [] } = product;

const abs = (path: string) => new URL(path, Astro.site).toString();
const pageUrl = abs(`/products/${product.slug}`);
const facts = productFacts(product);
const links = productLinks(product);

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  description: product.tagline,
  url: product.links.app ?? product.links.docs ?? pageUrl,
  image: abs(image.src),
  applicationCategory: product.applicationCategory ?? 'BusinessApplication',
  operatingSystem: operatingSystem(product),
  datePublished: product.launched,
  ...(product.license ? { license: `https://spdx.org/licenses/${product.license}.html` } : {}),
  ...(product.languages?.length ? { inLanguage: product.languages.map((l) => l.toLowerCase()) } : {}),
  ...(product.links.download ? { downloadUrl: product.links.download } : {}),
  ...(product.links.source ? { sameAs: [product.links.source] } : {}),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: {
    '@type': 'Person',
    name: 'Meftun Akarsu',
    url: abs('/'),
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Products', item: abs('/products') },
    { '@type': 'ListItem', position: 3, name: product.name, item: pageUrl },
  ],
};

// Figures break out of the text column on wide screens, as essay figures do.
const figureClass = 'overflow-hidden rounded-xl border border-fg-line bg-paper-sunk md:-mx-6 lg:-mx-24 xl:-mx-40';
const captionClass = 'border-t border-fg-line px-4 py-3 text-[0.95rem] leading-relaxed text-fg-muted sm:px-6';
---

<Layout
  title={`${product.metaTitle ?? product.name} — Meftun Akarsu`}
  description={product.summary ?? product.tagline}
  ogImage={image.src}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article class="mx-auto max-w-[46rem] px-6 pt-14 sm:pt-20" aria-labelledby="product-title">
    <SectionMeta
      as="h1"
      kicker={`${product.status} · ${fmtMonth(product.launched)}`}
      title={product.name}
      titleId="product-title"
      spec={product.spec}
      lead={product.tagline}
    />

    <p class="t-body measure mb-8" data-reveal>{product.description}</p>

    {facts.length > 0 && (
      <dl class="mb-10 grid grid-cols-[auto_1fr] items-baseline gap-x-8 gap-y-2" data-reveal style="--i:1">
        {facts.map((f) => (
          <Fragment>
            <dt class="t-label text-fg-muted">{f.label}</dt>
            <dd class="t-mono">{f.value}</dd>
          </Fragment>
        ))}
      </dl>
    )}

    {links.length > 0 && (
      <div class="mb-14 flex flex-wrap items-center gap-3" data-reveal style="--i:2">
        {links.map((l, i) => (
          <Button href={l.href} variant={i === 0 ? 'primary' : 'secondary'} external>{l.label}</Button>
        ))}
      </div>
    )}

    <figure class={`mb-16 ${figureClass}`} data-reveal>
      {video ? (
        <Fragment>
          <video
            controls
            playsinline
            preload="metadata"
            poster={video.poster}
            src={video.src}
            aria-label={`${product.name} demo video`}
            class="block aspect-video h-auto w-full"
          >
            <a href={video.src}>Download the {product.name} demo video</a>.
          </video>
          <figcaption class={captionClass}>
            <span class="t-mono mr-2">Demo</span>{video.caption}
          </figcaption>
        </Fragment>
      ) : (
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
        />
      )}
    </figure>

    {steps.length > 0 && (
      <section class="mb-16" aria-labelledby="how-it-works" data-reveal>
        <Label id="how-it-works">How it works</Label>
        <ol>
          {steps.map((step, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-3 border-b border-fg-line py-5">
              <span aria-hidden="true" class="t-mono pt-1.5 text-fg-muted">{twoDigits(i + 1)}</span>
              <div>
                <h3 class="font-display text-[1.2rem] font-medium leading-snug">{step.title}</h3>
                <p class="t-body mt-1 text-fg-muted">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {product.features.length > 0 && (
      <section class="mb-16" aria-labelledby="features" data-reveal>
        <Label id="features">Features</Label>
        <ul class="space-y-3">
          {product.features.map((feature) => (
            <li class="t-body relative pl-6 before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-3 before:bg-accent">
              {feature}
            </li>
          ))}
        </ul>
      </section>
    )}

    {gallery.length > 0 && (
      <section class="mb-16" aria-labelledby="screenshots">
        <Label id="screenshots">Screenshots</Label>
        <div class="space-y-10">
          {gallery.map((fig, i) => (
            <figure class={figureClass} data-reveal>
              {fig.images.length === 1 && fig.images[0].src.endsWith('.gif') ? (
                // A GIF cannot be paused, so it loads and plays only once the reader opens it (WCAG 2.2.2).
                <details>
                  <summary class="cursor-pointer px-4 py-3 text-fg-muted hover:text-fg sm:px-6">Play the animation</summary>
                  <img
                    src={fig.images[0].src}
                    alt={fig.images[0].alt}
                    width={fig.images[0].width}
                    height={fig.images[0].height}
                    loading="lazy"
                    decoding="async"
                    class="block h-auto w-full"
                  />
                </details>
              ) : fig.images.length === 1 ? (
                <img
                  src={fig.images[0].src}
                  alt={fig.images[0].alt}
                  width={fig.images[0].width}
                  height={fig.images[0].height}
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full"
                />
              ) : (
                <div class="flex justify-center gap-4 p-4 sm:gap-8 sm:p-8">
                  {fig.images.map((img) => (
                    <img
                      src={img.src}
                      alt={img.alt}
                      width={img.width}
                      height={img.height}
                      loading="lazy"
                      decoding="async"
                      class:list={[
                        'block h-auto min-w-0 flex-1 rounded-lg border border-fg-line',
                        // Phone screenshots stay phone-sized; wide ones share the row.
                        img.height > img.width && 'max-w-[240px]',
                      ]}
                    />
                  ))}
                </div>
              )}
              <figcaption class={captionClass}>
                <span class="t-mono mr-2">Fig {i + 1}</span>{fig.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {product.stack.length > 0 && (
      <section class="mb-16" aria-labelledby="built-with">
        <Label id="built-with">Built with</Label>
        <p class="t-mono text-fg-muted">{product.stack.join(' · ')}</p>
      </section>
    )}

    <p><a href="/products" class="t-mono text-fg-muted hover:text-fg">← All products</a></p>
  </article>
</Layout>
