---
import Layout from '../../layouts/Layout.astro';
import SectionMeta from '../../components/site/SectionMeta.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../../constants';

// Newest launch first. "YYYY-MM" strings sort correctly as text, and the sort
// is stable, so products launched in the same month keep their PRODUCTS order.
const products = [...PRODUCTS].sort((a, b) => b.launched.localeCompare(a.launched));
const years = products.map((p) => Number(p.launched.slice(0, 4)));
const first = Math.min(...years);
const last = Math.max(...years);
const span = first === last ? String(first) : `${first}–${last}`;

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Products by Meftun Akarsu',
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/products/${p.slug}`, Astro.site).toString(),
    name: p.name,
  })),
};
---

<Layout
  title="Products — Meftun Akarsu"
  description={['Software I build and run.', ...products.map((p) => `${p.name}: ${p.tagline}`)].join(' ')}
  ogImage={products[0]?.image.src}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  <div class="mx-auto max-w-[46rem] px-6 pt-14 sm:pt-20">
    <SectionMeta
      as="h1"
      kicker={`Products · ${span}`}
      title="Products"
      titleId="products-title"
      lead="Software I build and run, newest first."
    />
    <ul class="grid gap-x-8 gap-y-14 sm:grid-cols-2">
      {products.map((product, i) => (
        <li data-reveal style={`--i:${i % 2}`}>
          <ProductCard product={product} as="h2" eager={i < 2} />
        </li>
      ))}
    </ul>
  </div>
</Layout>
