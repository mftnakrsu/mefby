---
import Layout from '../../layouts/Layout.astro';
import SectionMeta from '../../components/site/SectionMeta.astro';
import CourseEntry from '../../components/CourseEntry.astro';
import EssayRow from '../../components/EssayRow.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { COURSES, courseParts } from '../../lib/courses';

const essays = await getCollection('essays');
const all = essays.filter((e) => !e.data.draft && !e.data.isTranslation);

// Each course in part order, then the standalone essays, newest first. The
// "New" marker stays on the genuinely newest essay.
const byDateDesc = (a: CollectionEntry<'essays'>, b: CollectionEntry<'essays'>) =>
  b.data.date.getTime() - a.data.date.getTime();
const courses = COURSES.map((course) => ({ course, parts: courseParts(essays, course.series) }));
const standalone = all.filter((e) => e.data.seriesOrder == null).sort(byDateDesc);
const newestSlug = [...all].sort(byDateDesc)[0]?.id;
// Canonicals with a Turkish counterpart, so the bilingual claim stays accurate.
const bilingualCount = all.filter((e) => e.data.translationSlug).length;
---

<Layout title="Essays — Meftun Akarsu" description="Long-form technical essays.">
  <div class="mx-auto max-w-[1100px] px-6 pt-14 sm:px-10 sm:pt-20">
    <SectionMeta
      as="h1"
      kicker={`${all.length} essays · ${bilingualCount} also in Türkçe`}
      title="Essays"
      titleId="essays-title"
      lead="Framework-free courses that build RAG, agents and evals by hand, and essays on the systems around them."
    />

    <section aria-labelledby="courses" data-reveal>
      <h2 id="courses" class="t-heading mb-4">Courses</h2>
      <ul class="border-b border-fg-line">
        {courses.map(({ course, parts }) => (
          <li>
            <CourseEntry course={course} parts={parts.length} firstHref={parts[0] ? `/essays/${parts[0].id}` : course.href} />
          </li>
        ))}
      </ul>
    </section>

    {courses.map(({ course, parts }) => (
      <section aria-labelledby={`list-${course.series}`} class="mt-16 sm:mt-20" data-reveal>
        <h2 id={`list-${course.series}`} class="t-heading mb-4">{course.title}</h2>
        <ul class="border-t border-fg-line">
          {parts.map((essay) => <EssayRow essay={essay} featured={essay.id === newestSlug} />)}
        </ul>
      </section>
    ))}

    <section aria-labelledby="list-standalone" class="mt-16 sm:mt-20" data-reveal>
      <h2 id="list-standalone" class="t-heading mb-4">Standalone essays</h2>
      <ul class="border-t border-fg-line">
        {standalone.map((essay) => <EssayRow essay={essay} featured={essay.id === newestSlug} />)}
      </ul>
    </section>
  </div>
</Layout>
